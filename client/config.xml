<?xml version='1.0' encoding='utf-8'?>
<widget id="edu.uniserve.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>UniServe</name>
    <description>University Service Request, Appointment and Queue Hub</description>
    <author email="support@uniserve.edu.au" href="https://uniserve.edu.au">
        UniServe Development Team
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="http://*/*" />
    <allow-navigation href="https://*/*" />
    <preference name="Orientation" value="portrait" />
    <plugin name="cordova-plugin-camera" spec="^7.0.0" />
    <plugin name="cordova-plugin-whitelist" spec="^1.3.5" />
</widget>
